{
  "name": "electron-react-sqlite-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Electron, React, TypeScript, and SQLite starter",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "test": "tsc -p tsconfig.test.json && node --test .voice-validation/test-build/tests/*.test.js",
    "test:voice": "npm run build && tsc -p tsconfig.test.json && node --test .voice-validation/test-build/tests/native.integration.js"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tabler/icons-react": "^3.51.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sherpa-onnx-node": "2.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "com.example.electronreactsqlite",
    "productName": "Interview Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/voice-benchmark.wav",
        "to": "voice-benchmark.wav"
      },
      {
        "from": "resources/VOICE_BENCHMARK_NOTICE.md",
        "to": "VOICE_BENCHMARK_NOTICE.md"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sherpa-onnx-*/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
